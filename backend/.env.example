# Local backend development only. Replace all replace_with_* placeholders.
DATABASE_URL=postgresql+asyncpg://todo_app:replace_with_database_password@localhost:5432/todo_app
REDIS_URL=redis://:replace_with_redis_password@localhost:6379/0
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
