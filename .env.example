# Docker Compose configuration. Replace every replace_with_* placeholder.
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_url_safe_database_password
POSTGRES_DB=replace_with_database_name
POSTGRES_PORT=5432

REDIS_PASSWORD=replace_with_url_safe_redis_password
REDIS_PORT=6379

JWT_SECRET=replace_with_at_least_32_random_bytes

# Public, non-secret browser configuration.
FRONTEND_API_URL=http://localhost:8000
